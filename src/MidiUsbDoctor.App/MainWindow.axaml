<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="using:MidiUsbDoctor.Core"
        xmlns:local="using:MidiUsbDoctor.App"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="720"
        x:Class="MidiUsbDoctor.App.MainWindow"
        Width="1100"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        Icon="/Assets/AppIcon.png"
        Title="MIDI USB Doctor">
    <Window.Styles>
        <Style Selector="Button.accent-green">
            <Setter Property="Background" Value="#238636" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2EA043" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent-green:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2EA043" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.accent-green:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#196C2E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="#30363D" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderBrush" Value="#484F58" />
        </Style>
        <!-- Disabled buttons: keep them visibly buttons on every platform. The Fluent theme's
             default disabled look is near-black on this dark palette, especially on Windows. -->
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#262C36" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="BorderBrush" Value="#30363D" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30363D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
        </Style>
        <Style Selector="Button#ShowAllButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#388BFD" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button#ShowAllButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1158C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton#HideClockToggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderBrush" Value="#30363D" />
        </Style>
        <Style Selector="ToggleButton#HideClockToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30363D" />
            <Setter Property="Foreground" Value="#F0F6FC" />
        </Style>
        <Style Selector="ToggleButton#HideClockToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F6FEB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#388BFD" />
        </Style>
        <Style Selector="ToggleButton#HideClockToggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#388BFD" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="#0D1117">
        <Border Grid.Row="0" Padding="28,22" Background="#161B22">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                <Image Source="/Assets/AppIcon.png"
                       Width="{Binding #TitleBlock.Bounds.Height}"
                       Height="{Binding #TitleBlock.Bounds.Height}"
                       Stretch="Uniform" VerticalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <StackPanel x:Name="TitleBlock" Grid.Column="1" Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#F0F6FC"
                               Text="MIDI USB Doctor" />
                    <TextBlock Foreground="#8B949E"
                               Text="See where your MIDI is going — and where it stops." />
                </StackPanel>
                <Button x:Name="PauseButton" Grid.Column="2" Padding="18,10"
                        VerticalAlignment="Center" Content="Pause listening"
                        IsEnabled="False" Classes="subtle"
                        ToolTip.Tip="Release every MIDI port so a DAW or UxMIDI Tools can use them"
                        Click="PauseButton_OnClick" />
                <Button x:Name="RefreshButton" Grid.Column="3" Padding="18,10"
                        VerticalAlignment="Center" Content="Refresh devices"
                        Classes="accent-green"
                        Click="RefreshDevices_OnClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28" ColumnDefinitions="5*,6*" ColumnSpacing="20">
            <Border Padding="22" Background="#161B22" CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#F0F6FC"
                               Text="MIDI ports" />
                    <TextBlock x:Name="EndpointStatusText" Grid.Row="1" Margin="0,6,0,20"
                               Foreground="#8B949E" Text="Checking MIDI devices…" />

                    <Border Grid.Row="2" Padding="20" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <StackPanel x:Name="EmptyEndpointsPanel" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="12">
                                <Border Width="12" Height="12" Background="#484F58" CornerRadius="6" />
                                <TextBlock HorizontalAlignment="Center" Foreground="#C9D1D9"
                                           Text="No MIDI endpoints found" />
                                <TextBlock MaxWidth="260" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="#8B949E"
                                           Text="Connect the H12, then refresh devices." />
                            </StackPanel>

                            <ListBox x:Name="PortsList" IsVisible="False"
                                     Background="Transparent" BorderThickness="0"
                                     SelectionChanged="PortsList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:MidiPortPairViewModel">
                                        <Grid Margin="0,5" ColumnDefinitions="Auto,*,Auto"
                                              RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                            <Border Grid.RowSpan="2" Width="10" Height="10"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding ActivityBrush}" CornerRadius="5" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Foreground="#F0F6FC"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Title}" />
                                                <TextBlock FontSize="11" Foreground="#6E7681"
                                                           TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding HasSubtitle}"
                                                           Text="{Binding Subtitle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontSize="12" Foreground="#8B949E"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding LastSeenText}" />
                                                <TextBlock FontWeight="SemiBold" Foreground="#58A6FF"
                                                           Text="{Binding ChannelText}" />
                                            </StackPanel>
                                            <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Margin="0,2,0,0">
                                                <TextBlock DockPanel.Dock="Left" FontSize="12"
                                                           Foreground="#8B949E"
                                                           Text="{Binding InputStatus}" />
                                                <TextBlock DockPanel.Dock="Left" FontSize="12"
                                                           Foreground="#8B949E" Margin="12,0,0,0"
                                                           Text="{Binding OutputStatus}" />
                                                <TextBlock FontSize="12" Foreground="#8B949E"
                                                           Margin="12,0,0,0" TextAlignment="Right"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding LastMessageText}" />
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border x:Name="LabelEditor" Grid.Row="3" Margin="0,16,0,0" Padding="14"
                            Background="#0D1117" CornerRadius="8" IsVisible="False">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="LabelEditorTitle" FontSize="12" Foreground="#8B949E"
                                       TextTrimming="CharacterEllipsis"
                                       Text="What is on this port?" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="6">
                                <TextBlock FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"
                                           Text="Instrument" />
                                <TextBox x:Name="LabelTextBox" Grid.Column="1"
                                         PlaceholderText="e.g. Bass Station II"
                                         KeyDown="LabelTextBox_OnKeyDown" />
                                <TextBlock Grid.Row="1" FontSize="12" Foreground="#C9D1D9"
                                           VerticalAlignment="Center" Text="Plugged into" />
                                <TextBox x:Name="ConnectionTextBox" Grid.Row="1" Grid.Column="1"
                                         PlaceholderText="e.g. USB host 3, or DIN 1"
                                         KeyDown="LabelTextBox_OnKeyDown" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="ClearLabelButton" Padding="14,6" Content="Clear"
                                        Classes="subtle" Click="ClearLabel_OnClick" />
                                <Button x:Name="SaveLabelButton" Padding="14,6" Content="Save"
                                        Classes="accent-green" Click="SaveLabel_OnClick" />
                            </StackPanel>
                            <TextBlock x:Name="LabelStatusText" FontSize="12" Foreground="#8B949E"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,12,0,0" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button x:Name="TestButton" HorizontalAlignment="Stretch" Padding="12,10"
                                Content="Test input" IsEnabled="False"
                                Classes="accent-green" Click="TestButton_OnClick" />
                        <Button x:Name="OutputTestButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                Padding="12,10" Content="Test output" IsEnabled="False"
                                Classes="accent-green" Click="OutputTestButton_OnClick"
                                ToolTip.Tip="Sends one short note to this port's output, then asks whether the instrument sounded" />
                        <Button x:Name="ShowAllButton" Grid.Column="2" HorizontalAlignment="Stretch"
                                Padding="12,10" Content="Showing all" IsEnabled="False"
                                Background="#1F6FEB" Foreground="#FFFFFF" BorderBrush="#388BFD"
                                FontWeight="SemiBold"
                                Click="ShowAll_OnClick" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="22" Background="#161B22" CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#F0F6FC"
                                   Text="Live MIDI traffic" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="HideClockToggle" Padding="12,5" FontSize="12"
                                          Content="Hide clock" IsChecked="True"
                                          IsCheckedChanged="HideClockToggle_OnIsCheckedChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border x:Name="ActivityIndicator" Width="10" Height="10"
                                        VerticalAlignment="Center" Background="#484F58" CornerRadius="5" />
                                <TextBlock x:Name="MonitorStatusText" Foreground="#8B949E" Text="Waiting" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TrafficHelpText" Grid.Row="1" Margin="0,6,0,20"
                               Foreground="#8B949E" TextWrapping="Wrap"
                               Text="Listening on every input. Play a note and watch which port lights up." />

                    <Border x:Name="TestCard" Grid.Row="2" Margin="0,0,0,16" Padding="18"
                            Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="8" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock x:Name="TestHeadline" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#F0F6FC" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Text="Testing…" />
                            <Button x:Name="TestDismissButton" Grid.Column="1" Padding="12,5"
                                    FontSize="12" Content="Dismiss" Classes="subtle"
                                    Click="TestDismiss_OnClick" />
                            <ItemsControl x:Name="TestSummaryList" Grid.Row="1" Grid.ColumnSpan="2"
                                          Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:DeviceTestLine">
                                        <Grid Margin="0,2" ColumnDefinitions="150,*">
                                            <TextBlock Foreground="#8B949E" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Foreground="#F0F6FC"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TestAdviceText" Grid.Row="2" Grid.ColumnSpan="2"
                                       Margin="0,10,0,0" Foreground="#C9D1D9" TextWrapping="Wrap" />
                            <StackPanel x:Name="OutputQuestionPanel" Grid.Row="3" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Spacing="10" Margin="0,12,0,0"
                                        IsVisible="False">
                                <Button Padding="14,8" Content="Yes, I heard it" Classes="accent-green"
                                        Click="OutputHeard_OnClick" />
                                <Button Padding="14,8" Content="No, nothing" Classes="subtle"
                                        Click="OutputNotHeard_OnClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Padding="18" Background="#0D1117" CornerRadius="8">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="110,170,70,120,*" ColumnSpacing="8">
                                <TextBlock Foreground="#8B949E" Text="Time" />
                                <TextBlock Grid.Column="1" Foreground="#8B949E" Text="Port" />
                                <TextBlock Grid.Column="2" Foreground="#8B949E" Text="Ch" />
                                <TextBlock Grid.Column="3" Foreground="#8B949E" Text="Type" />
                                <TextBlock Grid.Column="4" Foreground="#8B949E" Text="Data" />
                            </Grid>
                            <TextBlock x:Name="EmptyTrafficText" Grid.Row="1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#484F58" Text="Play a note to begin" />
                            <ListBox x:Name="TrafficList" Grid.Row="1" IsVisible="False"
                                     Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:MidiTrafficRow">
                                        <Grid Margin="0,4" ColumnDefinitions="110,170,70,120,*" ColumnSpacing="8">
                                            <TextBlock Foreground="#C9D1D9" Text="{Binding Time}" />
                                            <TextBlock Grid.Column="1" Foreground="#C9D1D9"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Port}" />
                                            <TextBlock Grid.Column="2" Foreground="#C9D1D9"
                                                       Text="{Binding Channel}" />
                                            <TextBlock Grid.Column="3" Foreground="#58A6FF"
                                                       Text="{Binding Type}" />
                                            <TextBlock Grid.Column="4" Foreground="#C9D1D9"
                                                       Text="{Binding Data}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
