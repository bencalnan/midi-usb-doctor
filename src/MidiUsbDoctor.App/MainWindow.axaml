<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="using:MidiUsbDoctor.Core"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="720"
        x:Class="MidiUsbDoctor.App.MainWindow"
        Width="1100"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        Title="MIDI USB Doctor">
    <Grid RowDefinitions="Auto,*" Background="#0D1117">
        <Border Grid.Row="0" Padding="28,22" Background="#161B22">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#F0F6FC"
                               Text="MIDI USB Doctor" />
                    <TextBlock Foreground="#8B949E"
                               Text="See where your MIDI is going — and where it stops." />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Padding="18,10"
                        VerticalAlignment="Center" Content="Refresh devices"
                        Click="RefreshDevices_OnClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28" ColumnDefinitions="2*,3*" ColumnSpacing="20">
            <Border Padding="22" Background="#161B22" CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#F0F6FC"
                               Text="MIDI endpoints" />
                    <TextBlock x:Name="EndpointStatusText" Grid.Row="1" Margin="0,6,0,20"
                               Foreground="#8B949E" Text="Checking CoreMIDI…" />

                    <Border Grid.Row="2" Padding="20" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <StackPanel x:Name="EmptyEndpointsPanel" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="12">
                                <Border Width="12" Height="12" Background="#484F58" CornerRadius="6" />
                                <TextBlock HorizontalAlignment="Center" Foreground="#C9D1D9"
                                           Text="No MIDI endpoints found" />
                                <TextBlock MaxWidth="260" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="#8B949E"
                                           Text="Connect the H12, then refresh devices." />
                            </StackPanel>

                            <ListBox x:Name="EndpointsList" IsVisible="False"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:MidiEndpoint">
                                        <Grid Margin="0,5" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border Width="10" Height="10" VerticalAlignment="Center"
                                                    Background="#3FB950" CornerRadius="5" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Foreground="#F0F6FC" Text="{Binding Name}" />
                                                <TextBlock FontSize="12" Foreground="#8B949E"
                                                           Text="{Binding Direction}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="22" Background="#161B22" CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#F0F6FC"
                                   Text="Live MIDI traffic" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Border Width="10" Height="10" VerticalAlignment="Center"
                                    Background="#484F58" CornerRadius="5" />
                            <TextBlock Foreground="#8B949E" Text="Waiting" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="0,6,0,20" Foreground="#8B949E"
                               Text="Messages from the selected input will appear here." />

                    <Border Grid.Row="2" Padding="18" Background="#0D1117" CornerRadius="8">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="120,100,100,*">
                                <TextBlock Foreground="#8B949E" Text="Time" />
                                <TextBlock Grid.Column="1" Foreground="#8B949E" Text="Channel" />
                                <TextBlock Grid.Column="2" Foreground="#8B949E" Text="Type" />
                                <TextBlock Grid.Column="3" Foreground="#8B949E" Text="Data" />
                            </Grid>
                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#484F58" Text="Play a note to begin" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
